plot = marsh_total_count, height = cfg$params$height, width = cfg$params$width, dpi = cfg$params$dpi)
shannon <- ggplot(point_counts_2025_clean, aes(x = Point_ID, y = Shannon_Diversity, color = VisitNum)) +
geom_boxplot() +
facet_wrap(~ Site, scales = "free_x") +
labs( title = "Shannon Diversity by Site",
x = "Point ID",
y = "Shannon Diversity" ) +
theme_publish(base_size = 18) +
theme(panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
