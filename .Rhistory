# --- Build locations_sf robustly and map it ---
suppressPackageStartupMessages({
library(dplyr)
library(sf)
library(leaflet)
})
# Safe coalescer for label fields
`%or%` <- function(x, y) {
if (is.null(x) || length(x) == 0) return(y)
if (length(x) == 1 && (is.na(x) || (is.character(x) && !nzchar(x)))) return(y)
x
}
# 0) Basic check
stopifnot(exists("aru_locations"), is.data.frame(aru_locations))
# 1) Normalize column names and map likely headers
aru_norm <- aru_locations %>%
dplyr::rename_with(tolower) %>%  # <<-- correct function name
dplyr::rename(
name     = dplyr::any_of(c("name","site","site_id","station")),
lon      = dplyr::any_of(c("long_x","longitude","lon","long","x","long_dd")),
lat      = dplyr::any_of(c("lat_y","latitude","lat","y","lat_dd")),
easting  = dplyr::any_of(c("e","east","easting","x_utm")),
northing = dplyr::any_of(c("n","north","northing","y_utm"))
)
have_ll <- all(c("lon","lat") %in% names(aru_norm)) &&
any(!is.na(aru_norm$lon)) && any(!is.na(aru_norm$lat))
have_en <- all(c("easting","northing") %in% names(aru_norm)) &&
any(!is.na(aru_norm$easting)) && any(!is.na(aru_norm$northing))
if (!have_ll && !have_en) {
stop("ARU locations need either Longitude/Latitude (e.g., long_x/lat_y) ",
"or Easting/Northing columns.\nColumns present: ",
paste(names(aru_norm), collapse=", "))
}
# 2) Make sf points (Leaflet needs EPSG:4326)
if (have_ll) {
message("Using lon/lat (EPSG:4326) from columns: ",
paste(c("lon","lat"), collapse=", "))
locations_sf <- sf::st_as_sf(
aru_norm %>% filter(!is.na(lon), !is.na(lat)),
coords = c("lon","lat"),
crs = 4326
)
} else {
# If you only have Easting/Northing, set the correct CRS for them.
# This assumes NAD83 / UTM Zone 18N (EPSG:26918). Change en_crs if yours differs.
en_crs <- 26918
message("Using easting/northing; assuming CRS = EPSG:", en_crs,
" (NAD83 / UTM 18N). Change 'en_crs' if different.")
tmp_sf <- sf::st_as_sf(
aru_norm %>% filter(!is.na(easting), !is.na(northing)),
coords = c("easting","northing"),
crs = en_crs
)
locations_sf <- sf::st_transform(tmp_sf, 4326)
}
# 3) Expose Long/Lat columns for plotting / popups
coords <- sf::st_coordinates(locations_sf)
locations_projected <- locations_sf %>%
mutate(Long = coords[,1], Lat = coords[,2])
stopifnot(nrow(locations_projected) > 0)
pal <- leaflet::colorFactor("Set1",
domain = (locations_projected$name %or% locations_projected$Name))
maplng <- mean(locations_projected$Long, na.rm = TRUE)
maplat <- mean(locations_projected$Lat,  na.rm = TRUE)
leaflet(data = locations_projected, height = 725, width = "100%") %>%
setView(lng = maplng, lat = maplat, zoom = 10) %>%
addProviderTiles(providers$Esri.WorldImagery) %>%
addCircleMarkers(
~Long, ~Lat,
radius = 3,
fillColor = ~pal(name %or% Name),
stroke = TRUE, color = "white", weight = 0.75,
fillOpacity = 0.75,
popup = ~ paste0("<strong>ARU: </strong>", (name %or% Name),
"<br><strong>Lon: </strong>", round(Long,6),
"<br><strong>Lat: </strong>", round(Lat,6))
) %>%
addLegend("bottomright", pal = pal,
values = ~ (name %or% Name),
opacity = .95, title = "ARU Location")
