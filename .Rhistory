group_by(season) %>%
summarise(
n = n(),
min = min(bears_dist, na.rm = TRUE),
q1 = quantile(bears_dist, 0.25, na.rm = TRUE),
median = median(bears_dist, na.rm = TRUE),
mean = mean(bears_dist, na.rm = TRUE),
q3 = quantile(bears_dist, 0.75, na.rm = TRUE),
max = max(bears_dist, na.rm = TRUE)
)
# Combine results
data.frame(
Distance_m = c(1000, 500, 150),
Percent_of_Fixes = c(within_1000, within_500, within_150)
)
bears %>% filter(season != "NA")%>%
mutate(DistanceBin = cut(bears_dist,
breaks = c(0,150,500,1000,5000,9000),
labels = c("<150 m","150–500 m","500–1000 m","1000–5000 m",">5000 m"),
include.lowest = TRUE)) %>%
ggplot(aes(x = DistanceBin, fill = season)) +
geom_bar(position = "dodge") +
scale_fill_manual(
values = c(
"Early Summer" = "#76912F",
"Mid-summer to Fall" = "#65A8EE",
"Denning" = "#546E7A"
)
) +
theme_bw(base_size = 17) +
labs(title = "Bear Proximity to Streams by Season",
x = "Distance to Nearest Stream",
y = "Number of GPS Fixes")
bears %>% filter(season != "NA")%>%
mutate(DistanceBin = cut(bears_dist,
breaks = c(0,150,500,1000,5000,9000),
labels = c("<150 m","150–500 m","500–1000 m","1000–5000 m",">5000 m"),
include.lowest = TRUE)) %>%
# summarize % of fixes per year × season × distance bin
count(year, season, DistanceBin, name = "n") %>%
group_by(year, season) %>%
mutate(percent = 100 * n / sum(n)) %>%
ungroup() %>%
# optional: ensure year is numeric and order bins nicely
mutate(
year = factor(year, levels = 2008:2015),
DistanceBin = fct_rev(DistanceBin)   # so closest is at top if you like
) %>%
ggplot(aes(x = year, y = DistanceBin, fill = percent)) +
geom_tile(color = "white") +
facet_wrap(~ season) +
scale_fill_viridis_c(name = "% of GPS Fixes") +
theme_bw(base_size = 17) +
labs(
title = "Interannual Variation in Stream Proximity by Kodiak Brown Bears",
x = "Year",
y = "Stream Distance Bin"
) +
theme(
axis.text.x = element_text(angle = 30, vjust = 1, hjust = 1)
)
# Check for linearty using the bear activity as the response variable
response <- "activity"
predictors <- c("tempC","bears_dist", "DEM", "NDVI_Clip", "Slope_plan", "tpi_3x3", "Aspect_pla")
#loop through the predictors
for (var in predictors) {
p <- ggplot(bears, aes_string(x = var, y = response)) +
geom_point(alpha = 0.3) +
theme_bw(base_size = 17) +
geom_smooth(method = "lm", se = FALSE, color = "red") +
labs(title = paste("Linearity check:", response, "vs", var))
print(p)
}
