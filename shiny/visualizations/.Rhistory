x <-
# ---- Libraries ----
library(data.table)
library(dplyr)
library(tidyr)
library(lubridate)
# ---- Root folder ----
root <- "C:/Users/kelly/Documents/Master's Project Files/02_data_processed/birdNET/2024/CAT_A1"
# ---- Find all BirdNET results files ----
all_paths <- list.files(
path = root,
pattern = "BirdNET\\.results\\.csv$",
full.names = TRUE,
recursive = TRUE
)
# ---- Read and combine all files ----
all_content <- lapply(all_paths, function(p) {
x <- tryCatch(
fread(p, encoding = "UTF-8", data.table = FALSE),
error = function(e) NULL
)
if (is.null(x) || nrow(x) == 0) return(NULL)
x
})
all_content <- Filter(Negate(is.null), all_content)
all_result <- rbindlist(all_content, fill = TRUE)
all_result <- as.data.frame(all_result)
# ---- Fix column names (first 6 columns) ----
if (ncol(all_result) >= 6) {
names(all_result)[1:6] <- c("Start_s","End_s","Scientific_Name","Common_Name","Confidence","File")
}
# ---- Drop any non-detection rows ----
all_result <- all_result %>% filter(!is.na(Start_s))
# ---- Parse from File name (NEW format: Site_DetectorID_Date_Time.wav) ----
species_data <- all_result %>%
mutate(
Audio_File = basename(as.character(File)),
Audio_Stem = sub("\\.wav$", "", Audio_File, ignore.case = TRUE)
) %>%
separate(
Audio_Stem,
into = c("Site_drop", "Detector_ID", "Date", "Time"),
sep = "_",
extra = "drop",
fill = "right"
) %>%
select(-Site_drop) %>%
mutate(
# Ensure Time is HHMMSS (first 6 chars), then convert to HH:MM:SS
Time = substr(as.character(Time), 1, 6),
Time_hms = paste0(substr(Time, 1, 2), ":", substr(Time, 3, 4), ":", substr(Time, 5, 6)),
# Parse Date and build DateTime (UTC)
Date = ymd(Date),
Year = year(Date),
DateTime = ymd_hms(paste(Date, Time_hms), tz = "UTC")
) %>%
select(-Time_hms)
# ---- Metadata join (Year + Unit) ----
meta_path <- "C:/Users/kelly/Documents/GitHub/Soundscape-Analysis-Rare-Bird-Detection/data/metadata/LHC-Cattus_ARU_Site_Metadata.csv"
metadata <- fread(meta_path, encoding = "UTF-8", data.table = FALSE) %>%
mutate(
Year = as.integer(Year),
Unit = trimws(as.character(Unit))
)
species_data <- species_data %>%
mutate(Detector_ID = trimws(as.character(Detector_ID))) %>%
left_join(
metadata %>% select(Year, Unit, Site, Station, Lat, Long),
by = c("Year" = "Year", "Detector_ID" = "Unit")
)
# ---- Write output ----
write.csv(
species_data,
"C:/Users/kelly/Documents/GitHub/Soundscape-Analysis-Rare-Bird-Detection/data/processed/birdNET/2025 individual/CAT_A1_2024_BirdNET_processed.csv",
row.names = FALSE
)
