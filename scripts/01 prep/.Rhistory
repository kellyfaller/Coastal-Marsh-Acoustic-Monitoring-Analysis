dplyr::select(Station, Year, Common_Name, Percent) %>%
tidyr::pivot_wider(
names_from = Year,
values_from = Percent,
values_fill = 0) %>%
dplyr::mutate(
Delta = .data[[as.character(year_two)]] - .data[[as.character(year_one)]])
ggplot(delta_df, aes(x = Common_Name, y = Delta)) +
geom_col() +
geom_text(
aes(label = scales::percent(Delta, accuracy = 0.01),
vjust = ifelse(Delta < 0, 1.3, -0.3)),
size = 3.75) +
facet_grid(~ Station, scales = "free_x") +
scale_y_continuous(labels = scales::percent) +
labs(y = paste0("Change in percent of detections of species with >1% of total detections (", year_two, " - ", year_one, ")"),
