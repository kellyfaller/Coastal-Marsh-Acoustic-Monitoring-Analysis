View(comm_abund)
comm_pa_filt2 <- comm_abund %>%
dplyr::select(-Station)%>%
tibble::column_to_rownames("File_Name") %>%
as.matrix()
comm_pa_filt2[comm_pa_filt > 0] <- 1
data_spp <- data_spp %>%
mutate(
File_Key = basename(File_Name)
)
# Normalize matrix rownames similarly (handles path differences)
rownames(comm_pa_filt2) <- basename(rownames(comm_pa_filt2))
comm_pa_filt2 <- comm_abund %>%
dplyr::select(-Station)%>%
tibble::column_to_rownames("File_Name") %>%
as.matrix()
comm_pa_filt2[comm_pa_filt > 0] <- 1
data_spp <- data_spp %>%
mutate(
File_Key = basename(File_Name))
# Normalize matrix rownames similarly (handles path differences)
rownames(comm_pa_filt2) <- basename(rownames(comm_pa_filt2))
data_spp <- data_spp %>%
mutate(
Detected = as.integer(comm_pa_filt2[File_Key, species_code, drop = TRUE]))
stopifnot(species_code %in% colnames(comm_pa_filt))
stopifnot(all(data_spp$File_Key %in% rownames(comm_pa_filt)))
stopifnot(species_code %in% colnames(comm_pa_filt2))
stopifnot(all(data_spp$File_Key %in% rownames(comm_pa_filt2)))
# Step 2: Fit Poisson
m1 <- glm(
detections ~ Long + Lat,
data = data_spp,
family = poisson
)
# Step 2: Fit Poisson
m1 <- glm(
Detections ~ Long + Lat,
data = data_spp,
family = poisson
)
# Step 2: Fit Poisson
m1 <- glm(
Detected ~ Long + Lat,
data = data_spp,
family = poisson
)
data_spp$predicted_count <- predict(m1, type = "response")
ggplot2::ggplot(data_spp, ggplot2::aes(x = Point_ID)) +
ggplot2::geom_col(ggplot2::aes(y = predicted_count), fill = "grey60") +
ggplot2::geom_point(
ggplot2::aes(y = Detected, shape = DistBand, color = as.factor(VisitNum)),
size = 3
) +
ggplot2::labs(
title = paste0("Observed (points) vs Predicted (bars) detections per 15-min file (", species_code, ")"),
x = "Point",
y = "Detections"
) +
theme_publish() +
ggplot2::theme(axis.text.x = ggplot2::element_text(angle = 45, hjust = 1))
