geom_boxplot() +
facet_wrap(~ Site, scales = "free_x") +
labs( title = "Total Bird Count by Site",
x = "Point ID",
y = "Total bird count") +
theme_publish(base_size = 18) +
theme(panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
strip.text = element_text(face = "bold"),
legend.position = "right")
ggplot2::ggsave(
filename = file.path(cfg$outputs$figures_dir, "total_count_point_counts.png"),
plot = total_count, height = cfg$params$height, width = cfg$params$width, dpi = cfg$params$dpi)
marsh_total_count <- ggplot(point_counts_2025_clean %>% filter(Habitat != "Upland"), aes(x = Point_ID, y = Total_Count, color = VisitNum)) +
